<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
    <script src="/js/color-modes.js"></script>
    <link rel="stylesheet" href="/bootstrap-icons-1.10.5/font/bootstrap-icons.min.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/dark-light.css" />
    <link href="/css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/myStyle.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../components/dark-light.ejs') %>

    <main class="d-flex flex-nowrap">
      <%- include('../components/sidebar.ejs', {status: 'admin-stats'}) %>

      <div class="container-fluid" style="padding: 20px;">
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-bar-chart me-2"></i>Database Statistics</h2>
            <a href="/admin/dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Admin Dashboard
            </a>
        </div>

        <!-- User Statistics -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>User Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <i class="bi bi-people fs-1 text-primary"></i>
                            <h3 class="mt-2 mb-0"><%= userStats.total %></h3>
                            <p class="text-muted mb-0">Total Users</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <i class="bi bi-shield-check fs-1 text-warning"></i>
                            <h3 class="mt-2 mb-0"><%= userStats.admins %></h3>
                            <p class="text-muted mb-0">Administrators</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <i class="bi bi-person fs-1 text-secondary"></i>
                            <h3 class="mt-2 mb-0"><%= userStats.regularUsers %></h3>
                            <p class="text-muted mb-0">Regular Users</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Statistics by Gender -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-gender-ambiguous me-2"></i>Customers by Gender</h5>
            </div>
            <div class="card-body">
                <% if (customerStats.length === 0) { %>
                    <p class="text-center text-muted">No customer data available</p>
                <% } else { %>
                    <div class="row g-3">
                        <% customerStats.forEach(stat => { %>
                            <div class="col-md-6">
                                <div class="text-center p-3 border rounded">
                                    <% if (stat._id === 'male') { %>
                                        <i class="bi bi-gender-male fs-1 text-primary"></i>
                                    <% } else if (stat._id === 'female') { %>
                                        <i class="bi bi-gender-female fs-1 text-danger"></i>
                                    <% } else { %>
                                        <i class="bi bi-question-circle fs-1 text-secondary"></i>
                                    <% } %>
                                    <h3 class="mt-2 mb-0"><%= stat.count %></h3>
                                    <p class="text-muted mb-0 text-capitalize"><%= stat._id || 'Unknown' %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Top Countries -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-globe me-2"></i>Top 10 Countries</h5>
            </div>
            <div class="card-body">
                <% if (customersByCountry.length === 0) { %>
                    <p class="text-center text-muted">No customer data available</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Country</th>
                                    <th>Number of Customers</th>
                                    <th>Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% 
                                const totalCustomers = customersByCountry.reduce((sum, item) => sum + item.count, 0);
                                customersByCountry.forEach((country, index) => { 
                                    const percentage = ((country.count / totalCustomers) * 100).toFixed(1);
                                %>
                                    <tr>
                                        <td><strong>#<%= index + 1 %></strong></td>
                                        <td><%= country._id || 'Unknown' %></td>
                                        <td><%= country.count %></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                                    <div class="progress-bar" role="progressbar" 
                                                         style="width: <%= percentage %>%;" 
                                                         aria-valuenow="<%= percentage %>" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        <%= percentage %>%
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
      </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
