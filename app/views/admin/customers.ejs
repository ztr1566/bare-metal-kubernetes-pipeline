<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
    <script src="/js/color-modes.js"></script>
    <link rel="stylesheet" href="/bootstrap-icons-1.10.5/font/bootstrap-icons.min.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/dark-light.css" />
    <link href="/css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/myStyle.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../components/dark-light.ejs') %>

    <main class="d-flex flex-nowrap">
      <%- include('../components/sidebar.ejs', {status: 'admin-customers'}) %>

      <div class="container-fluid" style="padding: 20px;">
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-person-lines-fill me-2"></i>Manage Customers</h2>
            <a href="/admin/dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Admin Dashboard
            </a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">All Customers (<%= totalCustomers %>)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Country</th>
                                <th>Gender</th>
                                <th>Owner</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (customers.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center">No customers found</td>
                                </tr>
                            <% } else { %>
                                <% customers.forEach(customer => { %>
                                    <tr>
                                        <td><%= customer.firstname %> <%= customer.lastname %></td>
                                        <td><%= customer.email %></td>
                                        <td><%= customer.phone %></td>
                                        <td><%= customer.country %></td>
                                        <td>
                                            <% if (customer.gender === 'male') { %>
                                                <i class="bi bi-gender-male text-primary"></i> Male
                                            <% } else if (customer.gender === 'female') { %>
                                                <i class="bi bi-gender-female text-danger"></i> Female
                                            <% } else { %>
                                                <%= customer.gender %>
                                            <% } %>
                                        </td>
                                        <td><%= customer.userId ? customer.userId.email : 'N/A' %></td>
                                        <td><%= new Date(customer.createdAt).toLocaleDateString() %></td>
                                        <td>
                                            <form method="POST" action="/admin/customers/<%= customer._id %>?_method=DELETE" 
                                                  class="d-inline" 
                                                  onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Customer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
                            </li>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
      </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
