<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
    <script src="/js/color-modes.js"></script>
    <link rel="stylesheet" href="/bootstrap-icons-1.10.5/font/bootstrap-icons.min.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/dark-light.css" />
    <link href="/css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/myStyle.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../components/dark-light.ejs') %>

    <main class="d-flex flex-nowrap">
      <%- include('../components/sidebar.ejs', {status: 'admin-dashboard'}) %>

      <div class="container-fluid" style="padding: 20px;">
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-shield-lock me-2"></i>Admin Dashboard</h2>
        </div>

        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Total Users</h6>
                                <h2 class="mb-0"><%= stats.totalUsers %></h2>
                            </div>
                            <i class="bi bi-people fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Total Customers</h6>
                                <h2 class="mb-0"><%= stats.totalCustomers %></h2>
                            </div>
                            <i class="bi bi-person-lines-fill fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">Total Admins</h6>
                                <h2 class="mb-0"><%= stats.totalAdmins %></h2>
                            </div>
                            <i class="bi bi-shield-check fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Users -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>Recent Users</h5>
                <a href="/admin/users" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Full Name</th>
                                <th>Admin</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentUsers.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center">No users found</td>
                                </tr>
                            <% } else { %>
                                <% recentUsers.forEach(user => { %>
                                    <tr>
                                        <td><%= user.email %></td>
                                        <td><%= user.fullName || '-' %></td>
                                        <td>
                                            <% if (user.isAdmin) { %>
                                                <span class="badge bg-warning">Admin</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">User</span>
                                            <% } %>
                                        </td>
                                        <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Customers -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Recent Customers</h5>
                <a href="/admin/customers" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Country</th>
                                <th>Owner</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentCustomers.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center">No customers found</td>
                                </tr>
                            <% } else { %>
                                <% recentCustomers.forEach(customer => { %>
                                    <tr>
                                        <td><%= customer.firstname %> <%= customer.lastname %></td>
                                        <td><%= customer.email %></td>
                                        <td><%= customer.country %></td>
                                        <td><%= customer.userId ? customer.userId.email : 'N/A' %></td>
                                        <td><%= new Date(customer.createdAt).toLocaleDateString() %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row g-3">
            <div class="col-md-3">
                <a href="/admin/users" class="card text-center text-decoration-none h-100">
                    <div class="card-body">
                        <i class="bi bi-people fs-1 text-primary"></i>
                        <h6 class="mt-2 mb-0">Manage Users</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/customers" class="card text-center text-decoration-none h-100">
                    <div class="card-body">
                        <i class="bi bi-person-lines-fill fs-1 text-success"></i>
                        <h6 class="mt-2 mb-0">Manage Customers</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/stats" class="card text-center text-decoration-none h-100">
                    <div class="card-body">
                        <i class="bi bi-bar-chart fs-1 text-info"></i>
                        <h6 class="mt-2 mb-0">View Statistics</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/dashboard" class="card text-center text-decoration-none h-100">
                    <div class="card-body">
                        <i class="bi bi-arrow-left-circle fs-1 text-secondary"></i>
                        <h6 class="mt-2 mb-0">Back to Dashboard</h6>
                    </div>
                </a>
            </div>
        </div>
      </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
